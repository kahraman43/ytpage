# Bu dosya keystore bilgileriniz için bir şablondur.
# 
# NASIL KULLANILIR:
# 1. Bu dosyayı "keystore.properties" olarak yeniden adlandırın (veya kopyalayın)
# 2. Aşağıdaki değerleri kendi keystore bilgilerinizle değiştirin
# 3. Bu dosyayı proje kök dizinine koyun
#
# NOT: Gerçek keystore.properties dosyanızı asla git'e eklemeyin!
#      (.gitignore dosyasında zaten engellenmiştir)

storePassword=BURAYA_KEYSTORE_ŞİFRENİZ
keyPassword=BURAYA_KEY_ŞİFRENİZ
keyAlias=hesapmakinesi
storeFile=BURAYA_KEYSTORE_DOSYA_YOLU_JKS

# Örnek Windows:
# storeFile=C:\\Users\\KullaniciAdi\\Documents\\hesapmakinesi-release.jks

# Örnek Mac/Linux:
# storeFile=/Users/kullaniciadi/Documents/hesapmakinesi-release.jks
