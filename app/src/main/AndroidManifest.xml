<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        SimpleCalc - Android Hesap Makinesi
        Google Play Console için optimize edilmiş manifest dosyası
        
        Özellikler:
        - İnternet izni gerektirmez (offline çalışır)
        - Portrait mode (dikey ekran)
        - Android 5.0+ (API 21) desteği
        - Hardware acceleration aktif
    -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SimpleCalc"
        tools:targetApi="31">
        
        <!-- 
            Ana Activity - MainActivity
            
            Özellikler:
            - exported="true" : Launcher'dan başlatılabilir
            - screenOrientation="portrait" : Sadece dikey mod
            - configChanges : Ekran döndürmede yeniden oluşturma
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden">
            
            <!-- Launcher Intent Filter -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
    </application>

</manifest>
